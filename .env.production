# PRODUCTION ENVIRONMENT - DO NOT COMMIT TO GIT
# Copy this file to .env on production server and fill in actual values

# 🔐 Django Security
SECRET_KEY="change-this-to-a-secure-random-string-min-50-chars"
DEBUG=False
ALLOWED_HOSTS=door-app.duckdns.org,www.door-app.duckdns.org

# 📊 Database (PostgreSQL in Production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=door_app_prod
DB_USER=door_app_user
DB_PASSWORD=change-this-to-secure-password
DB_HOST=db
DB_PORT=5432

# 🌐 CORS & Frontend
CORS_ALLOWED_ORIGINS=https://door-app.duckdns.org,https://www.door-app.duckdns.org

# 📧 Email Configuration (optional, for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# 🔗 JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# 🪵 Logging
LOG_LEVEL=INFO
